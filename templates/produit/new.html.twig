{% extends 'base.html.twig' %}

{% block title %}{{ 'product.new_product_title'|trans }}{% endblock %}

{% block body %}
    <div style="margin-bottom: 1.5rem;">
        <a href="{{ path('app_home') }}" class="btn btn-sm btn-secondary">
            &larr; {{ 'common.back_to_products'|trans }}
        </a>
    </div>

    <div class="form-card">
        <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem; text-align: center;">
            ➕ {{ 'product.new_product_title'|trans }}
        </h1>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="form-group">
                {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Casque Audio Pro'}}) }}
                <div class="form-error">{{ form_errors(form.nom) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Description détaillée du produit...'}}) }}
                <div class="form-error">{{ form_errors(form.description) }}</div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group">
                    {{ form_label(form.prix, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'placeholder': '99.99'}}) }}
                    <div class="form-error">{{ form_errors(form.prix) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.stock, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.stock, {'attr': {'class': 'form-control', 'placeholder': '10'}}) }}
                    <div class="form-error">{{ form_errors(form.stock) }}</div>
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.photoFile, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.photoFile, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.photoFile) }}</div>
            </div>

            <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
                <a href="{{ path('app_home') }}" class="btn btn-secondary">{{ 'common.cancel'|trans }}</a>
                <button type="submit" class="btn btn-primary">💾 {{ 'common.save'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
