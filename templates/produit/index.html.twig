
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ma Boutique - Accueil</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        header {
            background: #222;
            color: white;
            padding: 20px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        header h1 {
            margin: 0;
            color: #facc15;
        }

        header a {
            color: white;
            text-decoration: none;
            margin-left: 15px;
        }

        main {
            max-width: 1200px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .titre {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
            flex-wrap: wrap;
        }

        .ajouter {
            background: #16a34a;
            color: white;
            padding: 12px 18px;
            border-radius: 6px;
            text-decoration: none;
        }

        .produits {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 22px;
        }

        .carte {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px #00000012;
        }


        .carte img {
            width: 100%;
            height: 200px;
            object-fit: contain;
            background: white;
        }


        .details {
            padding: 18px;
        }

        .prix {
            color: #16a34a;
            font-size: 21px;
            font-weight: bold;
        }


        .voir {
            display: inline-block;
            background: #222;
            color: white;
            padding: 10px 14px;
            border-radius: 5px;
            text-decoration: none;
        }

        .vide {
            background: white;
            padding: 25px;
            border-radius: 8px;
        }


        @media (max-width: 600px) {
            header {
                align-items: flex-start;
                flex-direction: column;
            }

            header a {
                margin-left: 0;
                margin-right: 12px;
            }
        }
    </style>
</head>

<body>
    <header>
        <h1>Ma Boutique</h1>

        <nav>
            <a href="{{ path('app_accueil') }}">Accueil</a>

            {% if app.user %}
                <span>Bonjour {{ app.user.prenom }}</span>
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}">Connexion</a>
                <a href="{{ path('app_register') }}">Inscription</a>
            {% endif %}
        </nav>
    </header>

    <main>
        {% for message in app.flashes('success') %}
            <p class="vide">{{ message }}</p>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <p class="vide">{{ message }}</p>
        {% endfor %}

        <div class="titre">
            <div>
                <h2>Nos produits</h2>
                <p>Découvrez notre catalogue.</p>
            </div>

            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
                <a class="ajouter" href="{{ path('app_produit_new') }}">
                    + Ajouter un produit
                </a>
            {% endif %}
        </div>

        {% if produits is empty %}
            <div class="vide">
                Aucun produit disponible pour le moment.
            </div>
        {% else %}
            <div class="produits">
                {% for produit in produits %}
                    <article class="carte">
                        {% if produit.photo %}
                            <img
                                src="{{ asset('uploads/produits/' ~ produit.photo) }}"
                                alt="{{ produit.nom }}"
                            >
                        {% else %}
                            <img
                                src="https://placehold.co/400x300?text=Produit"
                                alt="Photo non disponible"
                            >
                        {% endif %}

                        <div class="details">
                            <h3>{{ produit.nom }}</h3>

                            <p>
                                {{ produit.description|default('Aucune description')|slice(0, 100) }}
                            </p>

                            <p class="prix">
                                {{ produit.prix|number_format(2, ',', ' ') }} €
                            </p>

                            <p>Stock : {{ produit.stock }}</p>

                            <a
                                class="voir"
                                href="{{ path('app_produit_show', {'id': produit.id}) }}"
                            >
                                Voir le produit
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </main>
</body>
</html>
