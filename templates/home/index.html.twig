{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
    <!-- Hero Banner -->
    <div class="hero">
        <div>
            <h1 class="hero-title">{{ 'home.title'|trans }}</h1>
            <p class="hero-subtitle">{{ 'home.subtitle'|trans }}</p>
        </div>
        
        <!-- Si l'utilisateur est connecté avec le rôle ROLE_ADMIN, il peut ajouter un produit sur cette page -->
        {% if is_granted('ROLE_ADMIN') %}
            <div>
                <a href="{{ path('app_produit_new') }}" class="btn btn-lg btn-primary" style="background: #fff; color: var(--primary); box-shadow: 0 4px 14px rgba(0,0,0,0.25);">
                    ➕ {{ 'home.add_product_btn'|trans }}
                </a>
            </div>
        {% endif %}
    </div>

    <!-- Grille des produits -->
    {% if produits is empty %}
        <div class="card" style="padding: 3rem; text-align: center;">
            <p style="color: var(--text-muted); font-size: 1.1rem;">{{ 'home.no_products'|trans }}</p>
            {% if is_granted('ROLE_ADMIN') %}
                <div style="margin-top: 1.5rem;">
                    <a href="{{ path('app_produit_new') }}" class="btn btn-primary">
                        ➕ {{ 'home.add_product_btn'|trans }}
                    </a>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="product-grid">
            {% for produit in produits %}
                <div class="card">
                    <div class="card-img-wrapper">
                        {% if produit.photo %}
                            <img src="{{ asset(produit.photo) }}" alt="{{ produit.nom }}" class="card-img">
                        {% else %}
                            <div class="card-img-placeholder">
                                🛍️
                            </div>
                        {% endif %}

                        <div class="card-badge">
                            {% if produit.stock > 0 %}
                                <span class="badge badge-success">{{ 'common.in_stock'|trans }} ({{ produit.stock }})</span>
                            {% else %}
                                <span class="badge badge-danger">{{ 'common.out_of_stock'|trans }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card-body">
                        <h2 class="card-title">{{ produit.nom }}</h2>
                        <p class="card-desc">{{ produit.description|default('Aucune description disponible pour ce produit.') }}</p>

                        <div class="card-footer-info">
                            <div class="product-price">
                                {{ produit.prix|number_format(2, ',', ' ') }} {{ 'common.currency'|trans }}
                            </div>

                            <!-- Au clic d'un produit on arrive sur la fiche du produit -->
                            <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="btn btn-sm btn-primary">
                                {{ 'home.view_product'|trans }} &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
