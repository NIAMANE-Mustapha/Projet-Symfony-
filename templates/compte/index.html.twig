{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block body %}
    <div style="margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main);">
            👤 {{ 'account.title'|trans }}
        </h1>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1.6fr; gap: 2.5rem; align-items: start;">
        <div class="card" style="padding: 2rem;">
            <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--text-main);">
                ⚙️ {{ 'account.profile_title'|trans }}
            </h2>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="form-group">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-error">{{ form_errors(form.nom) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-error">{{ form_errors(form.prenom) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-error">{{ form_errors(form.email) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-help">{{ 'account.password_help'|trans }}</div>
                    <div class="form-error">{{ form_errors(form.plainPassword.first) }}</div>
                </div>

                <div class="form-group">
                    {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-error">{{ form_errors(form.plainPassword.second) }}</div>
                </div>

                <div style="margin-top: 1.5rem;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        💾 {{ 'account.save_profile'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>

        <div>
            <div class="card" style="padding: 2rem;">
                <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--text-main);">
                    📦 {{ 'account.history_title'|trans }}
                </h2>

                {% if commandes is empty %}
                    <p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">
                        {{ 'account.no_orders'|trans }}
                    </p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'account.order_id'|trans }}</th>
                                    <th>{{ 'account.order_date'|trans }}</th>
                                    <th style="text-align: right;">{{ 'account.order_total'|trans }}</th>
                                    <th style="text-align: center;">{{ 'common.actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cmd in commandes %}
                                    <tr style="cursor: pointer;" onclick="window.location='{{ path('app_commande_show', {'id': cmd.id}) }}'">
                                        <td style="font-weight: 700; color: var(--primary);">
                                             #{{ cmd.id }}
                                        </td>
                                        <td style="color: var(--text-muted);">
                                            {{ cmd.dateAchat ? cmd.dateAchat|date('d/m/Y H:i') : '-' }}
                                        </td>
                                        <td style="text-align: right; font-weight: 700;">
                                            {{ cmd.total|number_format(2, ',', ' ') }} {{ 'common.currency'|trans }}
                                        </td>
                                        <td style="text-align: center;">
                                            <a href="{{ path('app_commande_show', {'id': cmd.id}) }}" class="btn btn-sm btn-secondary" onclick="event.stopPropagation();">
                                                🔍 {{ 'account.order_view'|trans }}
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
