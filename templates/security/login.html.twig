{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login_title'|trans }}{% endblock %}

{% block body %}
    <div class="form-card">
        <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem; text-align: center; color: var(--text-main);">
            🔐 {{ 'auth.login_title'|trans }}
        </h1>

        {% if error %}
            <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="username" class="form-label">{{ 'auth.email'|trans }}</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus placeholder="jean.dupont@example.com">
            </div>

            <div class="form-group">
                <label for="password" class="form-label">{{ 'auth.password'|trans }}</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required placeholder="••••••••">
            </div>

            <div style="margin-top: 2rem;">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    🚀 {{ 'auth.login_btn'|trans }}
                </button>
            </div>

            <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem;">
                <a href="{{ path('app_register') }}" style="color: var(--primary); font-weight: 600;">
                    {{ 'auth.no_account'|trans }} &rarr;
                </a>
            </div>
        </form>
    </div>
{% endblock %}
